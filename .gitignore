const express = require('express');
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const { all, get, run, parseJSON, defaultThemes, seedDefaults } = require('./db');

const app = express();
const port = process.env.PORT || 3000;
const uploadDirectory = path.join(__dirname, 'uploads');

fs.mkdirSync(uploadDirectory, { recursive: true });

app.use(express.json({ limit: '2mb' }));
app.use(express.urlencoded({ extended: true }));
app.use('/uploads', express.static(uploadDirectory));
app.use(express.static(__dirname));

const storage = multer.diskStorage({
  destination: (_req, _file, cb) => cb(null, uploadDirectory),
  filename: (_req, file, cb) => {
    const safeName = file.originalname.replace(/[^a-zA-Z0-9.-]/g, '_');
    const suffix = Date.now() + '-' + Math.round(Math.random() * 100000);
    cb(null, `${suffix}-${safeName}`);
  }
});

const upload = multer({
  storage,
  limits: {
    files: 20,
    fileSize: 5 * 1024 * 1024
  },
  fileFilter: (_req, file, cb) => {
    const valid = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    if (valid.includes(file.mimetype)) {
      cb(null, true);
      return;
    }
    cb(new Error('Only JPEG, PNG, WebP, and GIF images are allowed.'));
  }
});

async function getSettings() {
  const rows = await all('SELECT key, value FROM settings');
  return Object.fromEntries(rows.map((row) => [row.key, parseJSON(row.value, row.value)]));
}

async function getActiveTheme() {
  const settings = await getSettings();
  const themeId = Number(settings.themeId ?? 1);
  const activeTheme = await get('SELECT * FROM themes WHERE id = ? OR active = 1 ORDER BY active DESC, id ASC LIMIT 1', [themeId]);
  return activeTheme || (await get('SELECT * FROM themes WHERE active = 1 LIMIT 1')) || defaultThemes[0];
}

async function listProducts() {
  const rows = await all('SELECT * FROM products ORDER BY featured DESC, id DESC');
  return rows.map((product) => ({
    ...product,
    tags: product.tags ? String(product.tags).split(',') : [],
    visible: !!product.visible,
    featured: !!product.featured
  }));
}

function safeNumber(value, fallback = 0) {
  const num = Number(value);
  return Number.isFinite(num) ? num : fallback;
}

app.get('/api/health', async (_req, res) => {
  try {
    await get('SELECT 1');
    res.json({ status: 'ok', database: 'ready' });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.get('/api/storefront', async (_req, res) => {
  try {
    const settings = await getSettings();
    const categories = await all('SELECT * FROM categories ORDER BY id ASC');
    const products = await listProducts();
    const themes = await all('SELECT * FROM themes ORDER BY id ASC');
    const activeTheme = await getActiveTheme();

    res.json({
      settings,
      categories,
      products,
      themes,
      activeTheme
    });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.get('/api/products', async (_req, res) => {
  try {
    const products = await listProducts();
    res.json(products);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.post('/api/products', async (req, res) => {
  try {
    const payload = req.body || {};
    const name = String(payload.name || '').trim();
    if (!name) return res.status(400).json({ error: 'Product name is required.' });

    const query = `
      INSERT INTO products (name, category, sku, description, price, wholesale_price, cost, stock, tags, image, featured, visible, variant)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `;

    const result = await run(query, [
      name,
      payload.category || 'General',
      payload.sku || `RMS-${Date.now()}`,
      payload.description || '',
      safeNumber(payload.price, 0),
      safeNumber(payload.wholesalePrice, safeNumber(payload.price, 0)),
      safeNumber(payload.cost, 0),
      safeNumber(payload.stock, 0),
      Array.isArray(payload.tags) ? payload.tags.join(',') : String(payload.tags || ''),
      payload.image || '',
      payload.featured ? 1 : 0,
      payload.visible === false ? 0 : 1,
      payload.variant || 'color: standard|size: standard'
    ]);

    const product = await get('SELECT * FROM products WHERE id = ?', [result.lastID]);
    res.status(201).json(product);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.put('/api/products/:id', async (req, res) => {
  try {
    const productId = Number(req.params.id);
    if (!productId) return res.status(400).json({ error: 'Invalid id.' });

    const existing = await get('SELECT * FROM products WHERE id = ?', [productId]);
    if (!existing) return res.status(404).json({ error: 'Product not found.' });

    const payload = req.body || {};
    const query = `
      UPDATE products
      SET name = ?, category = ?, sku = ?, description = ?, price = ?, wholesale_price = ?, cost = ?, stock = ?, tags = ?, image = ?, featured = ?, visible = ?, variant = ?, updated_at = CURRENT_TIMESTAMP
      WHERE id = ?
    `;

    await run(query, [
      payload.name ?? existing.name,
      payload.category ?? existing.category,
      payload.sku ?? existing.sku,
      payload.description ?? existing.description,
      safeNumber(payload.price, existing.price),
      safeNumber(payload.wholesalePrice, existing.wholesale_price),
      safeNumber(payload.cost, existing.cost),
      safeNumber(payload.stock, existing.stock),
      Array.isArray(payload.tags) ? payload.tags.join(',') : String(payload.tags ?? existing.tags ?? ''),
      payload.image ?? existing.image,
      payload.featured ? 1 : 0,
      payload.visible === false ? 0 : 1,
      payload.variant ?? existing.variant,
      productId
    ]);

    const updated = await get('SELECT * FROM products WHERE id = ?', [productId]);
    res.json(updated);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.delete('/api/products/:id', async (req, res) => {
  try {
    const productId = Number(req.params.id);
    const existing = await get('SELECT * FROM products WHERE id = ?', [productId]);
    if (!existing) return res.status(404).json({ error: 'Product not found.' });

    await run('DELETE FROM products WHERE id = ?', [productId]);
    res.json({ success: true, deletedId: productId });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.get('/api/categories', async (_req, res) => {
  try {
    const categories = await all('SELECT * FROM categories ORDER BY id ASC');
    res.json(categories);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.get('/api/requests', async (_req, res) => {
  try {
    const rows = await all('SELECT * FROM custom_requests ORDER BY id DESC');
    res.json(rows.map((row) => ({
      ...row,
      images: row.images ? JSON.parse(row.images) : []
    })));
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.post('/api/requests', upload.array('images', 20), async (req, res) => {
  try {
    const files = req.files || [];
    if (files.length > 20) {
      return res.status(400).json({ error: 'A custom request can include up to 20 images.' });
    }

    const payload = req.body || {};
    const normalizedImages = files.map((file) => `/uploads/${file.filename}`);
    const result = await run(`
      INSERT INTO custom_requests (
        customer_name, phone, email, product_name, category, description, quantity, budget, desired_date,
        size, color, material, printing_method, design_notes, status, notes, images
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      payload.customerName || payload.name || '',
      payload.phone || '',
      payload.email || '',
      payload.productName || '',
      payload.category || 'Custom Request',
      payload.description || '',
      safeNumber(payload.quantity, 1),
      payload.budget || '',
      payload.desiredDate || '',
      payload.size || '',
      payload.color || '',
      payload.material || '',
      payload.printingMethod || '',
      payload.designInstructions || '',
      'Submitted',
      payload.notes || '',
      JSON.stringify(normalizedImages)
    ]);

    const request = await get('SELECT * FROM custom_requests WHERE id = ?', [result.lastID]);
    res.status(201).json({ ...request, images: request.images ? JSON.parse(request.images) : [] });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.get('/api/themes', async (_req, res) => {
  try {
    const themes = await all('SELECT * FROM themes ORDER BY id ASC');
    res.json(themes);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.post('/api/themes/:id/activate', async (req, res) => {
  try {
    const themeId = Number(req.params.id);
    const theme = await get('SELECT * FROM themes WHERE id = ?', [themeId]);
    if (!theme) return res.status(404).json({ error: 'Theme not found.' });

    await run('UPDATE themes SET active = 0');
    await run('UPDATE themes SET active = 1 WHERE id = ?', [themeId]);
    await run('UPDATE settings SET value = ? WHERE key = ?', [String(themeId), 'themeId']);

    res.json({ success: true, activeTheme: theme });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.get('/api/owner/settings', async (_req, res) => {
  try {
    const settings = await getSettings();
    res.json(settings);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.put('/api/owner/settings', async (req, res) => {
  try {
    const updates = req.body || {};
    const entries = Object.entries(updates);

    for (const [key, value] of entries) {
      await run('INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value', [key, typeof value === 'string' ? value : JSON.stringify(value)]);
    }

    const settings = await getSettings();
    res.json(settings);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.get('/api/orders', async (_req, res) => {
  try {
    const orders = await all('SELECT * FROM orders ORDER BY id DESC');
    res.json(orders.map((order) => ({ ...order, items: order.items ? JSON.parse(order.items) : [] }))); 
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.post('/api/orders', async (req, res) => {
  try {
    const payload = req.body || {};
    const items = Array.isArray(payload.items) ? payload.items : [];
    const customerName = String(payload.customerName || 'Walk-in');
    const phone = String(payload.phone || '');
    const total = items.reduce((sum, item) => sum + safeNumber(item.price, 0) * safeNumber(item.quantity, 1), 0);

    const orderResult = await run(
      'INSERT INTO orders (customer_name, phone, status, total, items) VALUES (?, ?, ?, ?, ?)',
      [customerName, phone, payload.status || 'Pending', total, JSON.stringify(items)]
    );

    for (const item of items) {
      const productId = Number(item.id);
      if (!productId) continue;
      const product = await get('SELECT * FROM products WHERE id = ?', [productId]);
      if (!product) continue;
      const updatedStock = Math.max(0, Number(product.stock) - Number(item.quantity || 1));
      await run('UPDATE products SET stock = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?', [updatedStock, productId]);
    }

    const order = await get('SELECT * FROM orders WHERE id = ?', [orderResult.lastID]);
    res.status(201).json({ ...order, items: order.items ? JSON.parse(order.items) : [] });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.use((err, _req, res, _next) => {
  if (err instanceof multer.MulterError) {
    res.status(400).json({ error: err.message });
    return;
  }

  res.status(500).json({ error: err.message || 'Server error' });
});

async function startServer() {
  await seedDefaults();
  app.listen(port, () => {
    console.log(`Royal Mobile And Printing Store app running on http://localhost:${port}`);
  });
}

if (require.main === module) {
  startServer();
}

module.exports = { app, startServer };
